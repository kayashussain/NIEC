# Real student & financial data never goes in git. It lives on the host's persistent
# disk (or your local machine) only.
student-details/data.json
student-details/data.backup*.json
counselor-incentive/commissions.json
counselor-incentive/commissions.backup*.json
counselor-incentive/advances.json
counselor-incentive/advances.backup*.json
counselor-incentive/exchange-rate-cache.json
**/backups/

# Accounts, logins, settings and the activity record: private, kept with the data only.
student-details/users.json
student-details/sessions.json
student-details/settings.json
student-details/mail.json
student-details/fact-file.json
student-details/session-secret
student-details/activity.jsonl
*.tmp

# Per-machine Claude Code session config, not part of the app. Only the shared .claude/settings.json is kept in git.
.claude/*
!.claude/settings.json
**/.claude/settings.local.json

.env
*.log
mail.json

